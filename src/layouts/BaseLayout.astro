---
import { SITE_CONFIG } from '../utils/config';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string[] | string;
}

const {
  title = SITE_CONFIG.defaultMeta.title,
  description = SITE_CONFIG.defaultMeta.description,
  image = SITE_CONFIG.defaultMeta.image,
  type = SITE_CONFIG.defaultMeta.type,
  keywords,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.url);
const normalizedKeywords = Array.isArray(keywords) ? keywords.join(', ') : keywords;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || SITE_CONFIG.analytics.gaMeasurementId;
---

<!DOCTYPE html>
<html lang={SITE_CONFIG.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {normalizedKeywords && <meta name="keywords" content={normalizedKeywords} />}
    <meta name="author" content={SITE_CONFIG.author} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content={SITE_CONFIG.title} />
    <meta property="og:locale" content={SITE_CONFIG.locale} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:creator" content={SITE_CONFIG.twitter} />

    <link rel="alternate" type="application/rss+xml" title={SITE_CONFIG.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+TC:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline>
          {`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${gaMeasurementId}');
          `}
        </script>
      </>
    )}
  </head>
  <body>
    <div class="site-background" aria-hidden="true"></div>
    <slot />

    <style is:global>
      :root {
        --color-primary: #0ea5e9;
        --color-primary-dark: #0369a1;
        --color-secondary: #1e3a8a;
        --color-accent: #f59e0b;

        --color-text: #0f172a;
        --color-text-light: #334155;
        --color-bg: #fefefe;
        --color-bg-secondary: #ffffff;
        --color-border: #d6e4f3;
        --color-border-light: #edf4fb;

        --bg-radial-1: rgba(14, 165, 233, 0.14);
        --bg-radial-2: rgba(245, 158, 11, 0.1);

        --font-family: 'IBM Plex Sans TC', 'Noto Sans TC', sans-serif;
        --font-heading: 'Space Grotesk', 'IBM Plex Sans TC', sans-serif;

        --font-size-sm: 0.875rem;
        --font-size-base: 1rem;
        --font-size-lg: 1.125rem;
        --font-size-xl: 1.25rem;
        --font-size-2xl: 1.5rem;
        --font-size-3xl: 1.875rem;
        --font-size-4xl: 2.25rem;

        --spacing-xs: 0.5rem;
        --spacing-sm: 0.75rem;
        --spacing-md: 1rem;
        --spacing-lg: 1.5rem;
        --spacing-xl: 2rem;
        --spacing-2xl: 3rem;
        --spacing-3xl: 4rem;
        --spacing-4xl: 5rem;

        --border-radius: 0.7rem;
        --border-radius-lg: 1rem;

        --shadow-sm: 0 2px 10px rgba(15, 23, 42, 0.04);
        --shadow-md: 0 14px 30px rgba(15, 23, 42, 0.08);
        --shadow-lg: 0 24px 45px rgba(15, 23, 42, 0.12);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--font-family);
        scroll-behavior: smooth;
      }

      body {
        position: relative;
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.75;
        font-size: var(--font-size-base);
      }

      .site-background {
        position: fixed;
        inset: 0;
        background:
          radial-gradient(circle at 10% 0%, var(--bg-radial-1), transparent 48%),
          radial-gradient(circle at 90% 12%, var(--bg-radial-2), transparent 42%),
          linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        pointer-events: none;
        z-index: -1;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: var(--font-heading);
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin-bottom: var(--spacing-md);
      }

      h1 {
        font-size: clamp(2rem, 4vw, 3.3rem);
      }

      h2 {
        font-size: clamp(1.65rem, 3vw, 2.3rem);
      }

      h3 {
        font-size: clamp(1.2rem, 2vw, 1.45rem);
      }

      p {
        margin-bottom: var(--spacing-md);
        color: var(--color-text-light);
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
      }

      a:hover {
        color: var(--color-primary-dark);
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
        border-radius: var(--border-radius);
      }

      code {
        border: 1px solid var(--color-border);
        background: var(--color-bg-secondary);
        padding: 0.14rem 0.32rem;
        border-radius: 0.3rem;
        font-size: 0.9em;
      }

      pre {
        background: var(--color-bg-secondary);
        padding: var(--spacing-lg);
        border-radius: var(--border-radius-lg);
        overflow-x: auto;
        border: 1px solid var(--color-border);
        margin-bottom: var(--spacing-lg);
      }

      pre code {
        border: 0;
        padding: 0;
        background: transparent;
      }

      blockquote {
        border-left: 3px solid var(--color-primary);
        padding: var(--spacing-sm) var(--spacing-md);
        margin: var(--spacing-lg) 0;
        background: var(--color-bg-secondary);
        border-radius: 0 var(--border-radius) var(--border-radius) 0;
      }

      .container {
        width: min(1120px, calc(100% - 4rem));
        margin: 0 auto;
      }

      .prose {
        max-width: 72ch;
        margin: 0 auto;
      }

      .prose h1,
      .prose h2,
      .prose h3,
      .prose h4,
      .prose h5,
      .prose h6 {
        margin-top: var(--spacing-xl);
      }

      .prose p,
      .prose li {
        color: var(--color-text-light);
      }

      .prose ul,
      .prose ol {
        padding-left: 1.2rem;
        margin-bottom: var(--spacing-md);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: 999px;
        border: 1px solid transparent;
        padding: 0.7rem 1.15rem;
        min-height: 44px;
        font-size: 0.95rem;
        font-weight: 600;
        font-family: var(--font-heading);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
        text-decoration: none;
      }

      .btn-primary,
      .btn {
        background: linear-gradient(135deg, #0ea5e9, #38bdf8);
        color: #f8fafc;
        box-shadow: var(--shadow-sm);
      }

      .btn-primary:hover,
      .btn:hover {
        color: #f8fafc;
        box-shadow: var(--shadow-md);
      }

      .btn-secondary {
        background: transparent;
        color: var(--color-text);
        border-color: var(--color-border);
      }

      .btn-secondary:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
      }

      .card {
        border: 1px solid var(--color-border);
        background: color-mix(in srgb, var(--color-bg-secondary) 98%, #eff6ff);
        box-shadow: var(--shadow-sm);
        border-radius: var(--border-radius-lg);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }

      .card:hover {
        border-color: color-mix(in srgb, var(--color-primary) 50%, var(--color-border));
        box-shadow: var(--shadow-md);
        transform: translateY(-3px);
      }

      .section-title {
        margin-bottom: var(--spacing-sm);
      }

      .section-subtitle {
        max-width: 700px;
      }

      .fade-in {
        animation: fadeInUp 0.55s ease both;
      }

      .delay-1 {
        animation-delay: 0.1s;
      }

      .delay-2 {
        animation-delay: 0.2s;
      }

      .delay-3 {
        animation-delay: 0.3s;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          animation: none !important;
          transition: none !important;
          scroll-behavior: auto !important;
        }
      }

      @media (max-width: 768px) {
        .container {
          width: min(1120px, calc(100% - 2rem));
        }
      }
    </style>
  </body>
</html>
