---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_CONFIG } from '../utils/config';

const allBlogPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const latestPosts = allBlogPosts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);

const featuredPosts = latestPosts.filter((post) => post.data.featured).slice(0, 2);
const spotlightPosts = featuredPosts.length > 0 ? featuredPosts : latestPosts.slice(0, 2);

const uniqueTags = [...new Set(allBlogPosts.flatMap((post) => post.data.tags))].slice(0, 8);
---

<MainLayout title="Allen 的自動化特調" description="專注於 AI 與自動化實作，讓非工程背景也能一步步上手。">
  <section class="hero container">
    <div class="hero-copy fade-in">
      <p class="hero-kicker">AI x Automation x Practical Workflow</p>
      <h1>用白話理解 AI 與自動化，從概念到可落地流程。</h1>
      <p>
        這個部落格專門把 AI 與自動化拆成可理解的步驟。
        就算你不是工程背景，也可以先從入門文章開始，逐步建立觀念。
      </p>
      <div class="hero-actions">
        <a class="btn" href="/blog">閱讀最新文章</a>
        <a class="btn btn-secondary" href="/about">認識我</a>
      </div>
      <div class="hero-tags">
        {uniqueTags.map((tag) => (
          <span>#{tag}</span>
        ))}
      </div>
    </div>

    <div class="hero-panel card fade-in delay-1">
      <h2>你會在這裡學到</h2>
      <p>每個主題都提供「概念 + 實作 + 風險提醒」，閱讀壓力更低。</p>
      <ul>
        <li><strong>Prompt 架構</strong><span>怎麼把需求寫清楚，讓 AI 回答更穩</span></li>
        <li><strong>自動化流程</strong><span>把一次性聊天變成可重複 SOP</span></li>
        <li><strong>工具整合</strong><span>用 n8n 與 Webhook 串接跨工具工作流</span></li>
      </ul>
    </div>
  </section>

  <section class="container beginner-path fade-in delay-2">
    <div class="section-heading">
      <h2 class="section-title">AI 學習地圖</h2>
      <p class="section-subtitle">把「基礎 → 應用 → 賦能」做成固定路徑，照表學就不容易迷路。</p>
    </div>
    <div class="path-grid">
      <article class="path-item card">
        <p class="step">STEP 1</p>
        <h3>AI 基礎核心篇</h3>
        <p>先學 AI 觀念、提問方法與指令實作。</p>
      </article>
      <article class="path-item card">
        <p class="step">STEP 2</p>
        <h3>AI 中階應用篇</h3>
        <p>把 AI 用在圖像設計、辦公加速與學習升級。</p>
      </article>
      <article class="path-item card">
        <p class="step">STEP 3</p>
        <h3>AI 高階賦能篇</h3>
        <p>進入自動化、研究決策與 Vibe Coding 實戰。</p>
      </article>
    </div>
    <div class="path-cta">
      <a href="/learning-path" class="btn">查看完整學習地圖</a>
    </div>
  </section>

  <section class="container section fade-in delay-3">
    <div class="section-heading">
      <h2 class="section-title">焦點文章</h2>
      <p class="section-subtitle">從 AI 學習地圖到自動化流程設計，整理最常被問到的實戰主題。</p>
    </div>

    <div class="spotlight-grid">
      {spotlightPosts.map((post) => (
        <article class="spotlight card">
          <img src={post.data.heroImage || '/images/blog/default-post.svg'} alt={post.data.title} loading="lazy" />
          <div class="spotlight-content">
            <div class="meta-row">
              <span>{post.data.category}</span>
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('zh-TW')}
              </time>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="read-link">閱讀文章</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container section fade-in">
    <div class="section-heading">
      <h2 class="section-title">最新文章</h2>
      <p class="section-subtitle">每篇文章都聚焦可落地的步驟，盡量避免只談概念。</p>
    </div>

    <div class="post-grid">
      {latestPosts.map((post) => (
        <article class="post-item card">
          <div class="post-meta">
            <span class="category">{post.data.category}</span>
            <time datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('zh-TW')}
            </time>
          </div>
          <h3>
            <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
          </h3>
          <p>{post.data.description}</p>
          <div class="post-tags">
            {post.data.tags.slice(0, 3).map((tag) => (
              <span>#{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="section-footer">
      <a href="/blog" class="btn">查看全部文章</a>
    </div>
  </section>
</MainLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.2rem;
    padding-top: 2.6rem;
    align-items: stretch;
  }

  .hero-copy {
    padding: 1rem 0;
  }

  .hero-kicker {
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.8rem;
  }

  .hero-copy h1 {
    margin-bottom: 1rem;
    max-width: 20ch;
  }

  .hero-copy p {
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.2rem 0 1rem;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-tags span {
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .hero-panel {
    padding: 1.2rem;
  }

  .hero-panel h2 {
    margin-bottom: 0.6rem;
    font-size: 1.25rem;
  }

  .hero-panel ul {
    list-style: none;
    display: grid;
    gap: 0.7rem;
    margin-top: 0.8rem;
  }

  .hero-panel li {
    border: 1px solid var(--color-border-light);
    border-radius: 0.8rem;
    padding: 0.7rem;
    background: var(--color-bg-secondary);
    display: grid;
    gap: 0.2rem;
  }

  .hero-panel strong {
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  .hero-panel span {
    color: var(--color-text-light);
    font-size: 0.84rem;
  }

  .section {
    margin-top: 3.1rem;
  }

  .section-heading {
    margin-bottom: 1.1rem;
  }

  .beginner-path {
    margin-top: 2.2rem;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .path-item {
    padding: 1rem;
  }

  .path-item .step {
    margin-bottom: 0.45rem;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .path-item h3 {
    margin-bottom: 0.35rem;
    font-size: 1.05rem;
  }

  .path-cta {
    margin-top: 0.9rem;
  }

  .spotlight-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .spotlight {
    overflow: hidden;
  }

  .spotlight img {
    height: 210px;
    width: 100%;
    object-fit: cover;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .spotlight-content {
    padding: 0.95rem;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    font-size: 0.8rem;
    margin-bottom: 0.55rem;
    color: var(--color-text-light);
  }

  .meta-row span {
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .spotlight h3 {
    font-size: 1.2rem;
    margin-bottom: 0.45rem;
  }

  .read-link {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .post-item {
    padding: 1rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    font-size: 0.78rem;
    margin-bottom: 0.65rem;
    color: var(--color-text-light);
  }

  .category {
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  .post-item h3 {
    font-size: 1.03rem;
    margin-bottom: 0.4rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.45rem;
  }

  .post-tags span {
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 0.72rem;
    padding: 0.18rem 0.55rem;
    color: var(--color-text-light);
  }

  .section-footer {
    margin-top: 1.3rem;
  }

  @media (max-width: 1024px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 1.8rem;
    }

    .path-grid,
    .spotlight-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
