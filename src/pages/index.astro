---
import BlogCard from "@/components/BlogCard.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

const postIndex = await getListPage("blog", "-index");
const posts = sortByDate(await getSinglePage("blog"));
---

<Base
  title="AI 自動化 SRE"
  meta_title="AI 自動化"
  description={postIndex.data.description}
  image={postIndex.data.image}
>
  <section class="site-overview" aria-labelledby="site-overview-title">
    <div class="container site-overview-grid">
      <div>
        <p class="site-overview-kicker">Production notes for resilient systems</p>
        <h1 id="site-overview-title" class="site-overview-title">
          解構現代雲原生架構
        </h1>
        <p class="site-overview-summary">
          聚焦平台工程、可觀測性與事件應變：以可複製的架構、實作細節與失敗模式，將自動化從實驗推進到可靠的日常營運。
        </p>
      </div>
      <aside class="site-overview-panel" aria-label="網站主題">
        <h2>本站關注的系統能力</h2>
        <ul class="site-overview-list">
          <li><strong>Observe</strong>讓訊號、追蹤與告警可以形成決策。</li>
          <li><strong>Automate</strong>將重複處置做成安全、可驗證的流程。</li>
          <li><strong>Recover</strong>為失敗設計回滾、責任邊界與量化 KPI。</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section home-articles">
    <div class="container">
      <div class="home-articles-heading">
        <p class="home-articles-kicker">技術文章</p>
        <h2>複雜架構中尋找簡潔，重複流程中引入 AI</h2>
        <p>{postIndex.data.description}</p>
      </div>

      <div class="home-post-grid">
        {
          posts.map((post) => (
            <article class="home-post-card">
              <BlogCard data={post} />
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>
