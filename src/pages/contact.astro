---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("contact", "-index");
const { title, description, meta_title, image } = contactIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          <div class="rounded border border-border p-6 dark:border-darkmode-border">
            <p class="mb-6 text-lg">歡迎透過以下方式聯絡我：</p>
            <dl class="space-y-5">
              <div>
                <dt class="font-semibold">電子郵件</dt>
                <dd><a href="mailto:yutangshi@gmail.com">yutangshi@gmail.com</a></dd>
              </div>
              <div>
                <dt class="font-semibold">LINE ID</dt>
                <dd>yutang-shi</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
