---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_CONFIG } from '../utils/config';

const phone = SITE_CONFIG.phone?.trim();
const phoneDigits = phone ? phone.replace(/[\s()-]/g, '') : '';

const contactChannels = [
  {
    title: 'Email 聯絡',
    value: SITE_CONFIG.email,
    description: '最穩定的聯絡方式，適合提供需求細節。',
    href: SITE_CONFIG.social.email,
    action: '寄信給我'
  },
  {
    title: 'Line 即時訊息',
    value: 'yutang-shi',
    description: '適合快速討論需求與安排時段。',
    href: 'https://line.me/ti/p/~yutang-shi',
    action: 'Line 聯絡'
  },
  {
    title: 'LinkedIn',
    value: 'Yutang Shi',
    description: '商業合作與職涯相關交流。',
    href: SITE_CONFIG.social.linkedin,
    action: '開啟 LinkedIn'
  }
];

const faqs = [
  {
    question: '通常多久會回覆？',
    answer: '我通常會在 24 小時內回覆 Email 或 Line 訊息。'
  },
  {
    question: '可以預約電話或線上會議嗎？',
    answer: '可以，先寄信或 Line 告訴我你的需求，我會提供可預約時段。'
  },
  {
    question: '不懂 AI 自動化也可以詢問嗎？',
    answer: '可以。我會先用白話理解你的情境，再提供適合的建議。'
  }
];
---

<MainLayout title="聯絡我 - Allen Shi" description="透過電話、Email 或 Line 聯絡 Allen，討論 AI 自動化與 SRE 相關需求">
  <div class="container contact-page">
    <section class="contact-hero fade-in">
      <p class="hero-kicker">Contact</p>
      <h1>聯絡我</h1>
      <p>
        如果你想了解 AI 自動化或 SRE，歡迎直接聯絡我。
        我會用容易理解的方式，陪你把需求釐清。
      </p>

      <div class="hero-actions">
        {phone && (
          <a href={`tel:${phoneDigits}`} class="btn">立即撥打電話</a>
        )}
        <a href={SITE_CONFIG.social.email} class="btn">立即寄信</a>
      </div>
    </section>

    <section class="quick-grid fade-in delay-1">
      {phone ? (
        <a href={`tel:${phoneDigits}`} class="quick-card card">
          <h2>電話</h2>
          <p class="value">{phone}</p>
          <p>一鍵撥號，適合快速確認需求。</p>
        </a>
      ) : (
        <article class="quick-card card muted">
          <h2>電話</h2>
          <p class="value">尚未設定</p>
          <p>可在 `src/utils/config.ts` 填入 `phone` 啟用一鍵撥號。</p>
        </article>
      )}

      <a href={SITE_CONFIG.social.email} class="quick-card card">
        <h2>Email</h2>
        <p class="value">{SITE_CONFIG.email}</p>
        <p>適合完整描述需求、預算與時程。</p>
      </a>

      <a href="https://line.me/ti/p/~yutang-shi" class="quick-card card" target="_blank" rel="noopener noreferrer">
        <h2>Line</h2>
        <p class="value">yutang-shi</p>
        <p>適合即時簡短溝通與快速回覆。</p>
      </a>
    </section>

    <section class="channels fade-in delay-2">
      <div class="section-head">
        <h2>聯絡方式</h2>
        <p>選擇你最方便的管道。</p>
      </div>
      <div class="channel-grid">
        {contactChannels.map((channel) => (
          <article class="channel-item card">
            <h3>{channel.title}</h3>
            <p class="channel-value">{channel.value}</p>
            <p>{channel.description}</p>
            <a href={channel.href} class="btn btn-secondary" target={channel.href.startsWith('http') ? '_blank' : undefined} rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              {channel.action}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="faq-section fade-in delay-3">
      <div class="section-head">
        <h2>常見問題</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq) => (
          <article class="faq-item card">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <div class="mobile-action-bar">
    {phone && (
      <a href={`tel:${phoneDigits}`} class="mobile-action">撥號</a>
    )}
    <a href={SITE_CONFIG.social.email} class="mobile-action">寄信</a>
    <a href="https://line.me/ti/p/~yutang-shi" class="mobile-action" target="_blank" rel="noopener noreferrer">Line</a>
  </div>
</MainLayout>

<style>
  .contact-page {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .contact-hero p {
    max-width: 64ch;
  }

  .hero-kicker {
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.6rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .quick-card {
    padding: 1rem;
    color: inherit;
  }

  .quick-card:hover {
    text-decoration: none;
  }

  .quick-card.muted {
    background: #f8fafc;
  }

  .quick-card h2 {
    font-size: 1.08rem;
    margin-bottom: 0.3rem;
  }

  .quick-card .value {
    font-family: var(--font-heading);
    color: var(--color-primary-dark);
    margin-bottom: 0.35rem;
  }

  .channels,
  .faq-section {
    margin-top: 2rem;
  }

  .section-head {
    margin-bottom: 0.8rem;
  }

  .channel-grid,
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .channel-item,
  .faq-item {
    padding: 1rem;
  }

  .channel-value {
    color: var(--color-primary-dark);
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .channel-item .btn {
    margin-top: 0.5rem;
    width: 100%;
  }

  .mobile-action-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: none;
    gap: 0.5rem;
    padding: 0.6rem;
    background: rgba(255, 255, 255, 0.95);
    border-top: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
  }

  .mobile-action {
    flex: 1;
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: #ffffff;
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .mobile-action:hover {
    text-decoration: none;
    border-color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .quick-grid,
    .channel-grid,
    .faq-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .contact-page {
      padding-top: 1.2rem;
      padding-bottom: 6rem;
    }

    .quick-grid,
    .channel-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .mobile-action-bar {
      display: flex;
    }
  }
</style>
