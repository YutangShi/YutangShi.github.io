---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const allBlogPosts = await getCollection('blog', ({ data }) => data.draft !== true);

const byCategory = {
  AI: allBlogPosts.filter((p) => p.data.category === 'AI').slice(0, 4),
  自動化: allBlogPosts.filter((p) => p.data.category === '自動化').slice(0, 4),
  SRE: allBlogPosts.filter((p) => p.data.category === 'SRE').slice(0, 4),
  N8N: allBlogPosts.filter((p) => p.data.category === 'N8N').slice(0, 4)
};

const foundations = [
  '生成式 AI 與 LLM 基本觀念',
  '提示工程（清楚指令、範例、格式）',
  '把單次問答變成可重複流程'
];

const intermediateTracks = [
  {
    title: '工作應用入門',
    topics: ['AI 簡報與文件整理', '會議摘要', '知識筆記整理'],
    category: 'AI'
  },
  {
    title: '內容與設計應用',
    topics: ['圖像生成', '行銷素材草稿', '內容改寫與優化'],
    category: '自動化'
  },
  {
    title: '學習與研究應用',
    topics: ['文獻統整', '主題探索', '個人化學習計畫'],
    category: 'SRE'
  }
];

const advancedTracks = [
  {
    title: '流程自動化（N8N）',
    topics: ['N8N 基礎節點', 'Webhook 串接', '跨工具工作流'],
    category: 'N8N'
  },
  {
    title: '代理與系統整合',
    topics: ['工具調用', 'RAG/知識檢索', '多步驟任務拆解'],
    category: '自動化'
  },
  {
    title: '可靠上線',
    topics: ['評估指標設計', '風險與安全', '監控與持續改善'],
    category: 'SRE'
  }
];
---

<MainLayout title="AI學習地圖" description="用基礎、中階、高階三層路徑，循序學習 AI、自動化、SRE 與 N8N">
  <div class="container roadmap-page">
    <section class="roadmap-hero fade-in">
      <p class="kicker">Learning Map</p>
      <h1>AI學習地圖</h1>
      <p>
        我把內容改成「基礎概念 → 提示工程 → 工作流自動化 → 可靠上線」。
        這個順序更貼近官方教材與實務導入流程，能循序漸進學到 AI 應用技術。
      </p>
      <div class="actions">
        <a href="/blog" class="btn">開始學習</a>
      </div>
    </section>

    <section class="map-visual fade-in delay-1">
      <img src="/images/ai-learning-map.svg" alt="AI學習地圖完整範圍：基礎概念、提示工程、任務應用、自動化整合、可靠上線" loading="lazy" />
    </section>

    <section class="stage stage-foundation fade-in delay-2">
      <div class="stage-head">
        <h2>第一階段：基礎與提示工程</h2>
        <p>先打好模型觀念與提示能力，後續做自動化才不容易卡住。</p>
      </div>
      <div class="pill-row">
        {foundations.map((item) => (
          <div class="pill card">{item}</div>
        ))}
      </div>
    </section>

    <section class="stage fade-in delay-3">
      <div class="stage-head">
        <h2>第二階段：任務應用</h2>
        <p>把 AI 用在辦公、內容與學習場景，先做出可見成果。</p>
      </div>
      <div class="track-grid">
        {intermediateTracks.map((track) => (
          <article class="track card">
            <h3>{track.title}</h3>
            <ul>
              {track.topics.map((topic) => (
                <li>{topic}</li>
              ))}
            </ul>
            <a href="/blog" class="track-link">到部落格看相關文章（{track.category}）</a>
          </article>
        ))}
      </div>
    </section>

    <section class="stage fade-in">
      <div class="stage-head">
        <h2>第三階段：自動化與可靠上線</h2>
        <p>進入 N8N 與代理工作流，最後補上評估、安全與監控能力。</p>
      </div>
      <div class="track-grid">
        {advancedTracks.map((track) => (
          <article class="track card">
            <h3>{track.title}</h3>
            <ul>
              {track.topics.map((topic) => (
                <li>{topic}</li>
              ))}
            </ul>
            <a href="/blog" class="track-link">到部落格看相關文章（{track.category}）</a>
          </article>
        ))}
      </div>
    </section>

    <section class="stage current-posts fade-in">
      <div class="stage-head">
        <h2>目前可先讀的文章</h2>
        <p>依分類彙整，方便你照路線執行。</p>
      </div>

      <div class="category-grid">
        {Object.entries(byCategory).map(([name, posts]) => (
          <article class="category card">
            <h3>{name}</h3>
            {posts.length > 0 ? (
              <ul>
                {posts.map((post) => (
                  <li>
                    <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <p>此分類文章持續更新中。</p>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="stage evidence fade-in">
      <div class="stage-head">
        <h2>這個順序的依據</h2>
      </div>
      <div class="evidence-box card">
        <ul>
          <li>先有成功標準與評估，再做提示優化，能避免「感覺有效」但不可重現。</li>
          <li>提示工程建議從清楚指令、範例、迭代開始，屬於早期必備能力。</li>
          <li>工作流與代理屬於更高複雜度階段，應放在基礎之後。</li>
          <li>上線前後需要持續測試、量測與風險管理，才能長期穩定。</li>
        </ul>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .roadmap-page {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .kicker {
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.55rem;
  }

  .roadmap-hero p {
    max-width: 64ch;
  }

  .actions {
    margin-top: 0.85rem;
  }

  .map-visual {
    margin-top: 1.2rem;
  }

  .map-visual img {
    width: 100%;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background: #fff;
    box-shadow: var(--shadow-md);
  }

  .stage {
    margin-top: 2rem;
  }

  .stage-head {
    margin-bottom: 0.8rem;
  }

  .pill-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .pill {
    padding: 0.9rem;
    font-weight: 700;
  }

  .track-grid,
  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .evidence-box {
    padding: 1rem;
  }

  .evidence-box ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-text-light);
    display: grid;
    gap: 0.35rem;
  }

  .track,
  .category {
    padding: 1rem;
  }

  .track h3,
  .category h3 {
    font-size: 1.1rem;
    margin-bottom: 0.45rem;
  }

  .track ul,
  .category ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-text-light);
    display: grid;
    gap: 0.25rem;
  }

  .track-link {
    display: inline-flex;
    margin-top: 0.6rem;
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .track-grid,
    .category-grid,
    .pill-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .roadmap-page {
      padding-top: 1rem;
    }

    .track-grid,
    .category-grid,
    .pill-row {
      grid-template-columns: 1fr;
    }
  }
</style>
