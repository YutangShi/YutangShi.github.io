---
import Base from "@/layouts/Base.astro";
---

<Base title="找不到頁面">
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span
            class="text-[8rem] block font-bold text-text-dark dark:text-darkmode-text-dark"
          >
            404
          </span>
          <h1 class="h2 mb-4">找不到頁面</h1>
          <div class="content">
            <p>
              您要瀏覽的頁面可能已被移除、變更網址，或暫時無法使用。
            </p>
          </div>
          <a href="/" class="btn btn-primary mt-8">返回首頁</a>
        </div>
      </div>
    </div>
  </section>
</Base>
