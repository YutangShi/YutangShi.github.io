---
import { SITE_CONFIG } from '../utils/config';

const currentPath = Astro.url.pathname;
---

<header class="header-shell">
  <div class="container">
    <nav class="site-nav" aria-label="主選單">
      <a href="/" class="brand" aria-label="回到首頁">
        <span class="brand-dot" aria-hidden="true"></span>
        <span class="brand-name">{SITE_CONFIG.author}</span>
      </a>

      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="切換選單">
        <span></span>
        <span></span>
      </button>

      <div id="primary-nav" class="nav-links">
        {SITE_CONFIG.navigation.map((item) => (
          <a href={item.href} class={`nav-link ${currentPath === item.href ? 'active' : ''}`}>
            {item.name}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  .header-shell {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-top: 0.9rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-secondary) 88%, transparent);
    border-radius: 999px;
    padding: 0.55rem 0.8rem;
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(10px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text);
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-dot {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    background: linear-gradient(160deg, var(--color-primary), var(--color-accent));
    box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.12);
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .menu-btn {
    display: none;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--color-border);
    background: transparent;
    border-radius: 999px;
    padding: 0;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.23rem;
  }

  .menu-btn span {
    width: 1rem;
    height: 2px;
    border-radius: 10px;
    background: var(--color-text);
    transition: transform 0.2s ease;
  }

  .nav-links {
    display: flex;
    gap: 0.35rem;
    align-items: center;
  }

  .nav-link {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0 0.8rem;
    font-size: 0.92rem;
    color: var(--color-text-light);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-primary) 11%, transparent);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-primary-dark);
    background: color-mix(in srgb, var(--color-primary) 18%, transparent);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .site-nav {
      border-radius: 1rem;
      align-items: stretch;
      flex-wrap: wrap;
    }

    .menu-btn {
      display: inline-flex;
      margin-left: auto;
    }

    .nav-links {
      width: 100%;
      display: none;
      flex-direction: column;
      align-items: stretch;
      padding-top: 0.4rem;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-link {
      min-height: 44px;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.querySelector('.menu-btn');
    const nav = document.querySelector('.nav-links');
    if (!button || !nav) return;

    button.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      button.setAttribute('aria-expanded', String(open));
    });
  });
</script>
