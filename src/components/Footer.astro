---
import { SITE_CONFIG } from '../utils/config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-label">{SITE_CONFIG.author}</p>
      <h2>AI 自動化與 SRE 實戰筆記</h2>
      <p>{SITE_CONFIG.description}</p>
    </div>

    <div class="footer-group">
      <h3>內容導覽</h3>
      <ul>
        {SITE_CONFIG.navigation.map((item) => (
          <li><a href={item.href}>{item.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-group">
      <h3>社群連結</h3>
      <ul>
        <li><a href={SITE_CONFIG.social.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={SITE_CONFIG.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={SITE_CONFIG.social.twitter} target="_blank" rel="noopener noreferrer">X (Twitter)</a></li>
        <li><a href={SITE_CONFIG.social.email}>Email</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {currentYear} {SITE_CONFIG.author}</p>
    <p>Built with Astro. Deployed on Cloudflare Pages.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding-top: 2.7rem;
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-secondary) 82%, transparent);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 1.5rem;
  }

  .footer-label {
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-primary-dark);
    margin-bottom: 0.7rem;
  }

  .footer-brand h2 {
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    margin-bottom: 0.7rem;
  }

  .footer-brand p {
    max-width: 44ch;
  }

  .footer-group h3 {
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
    color: var(--color-text);
  }

  .footer-group ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .footer-group a {
    color: var(--color-text-light);
  }

  .footer-group a:hover {
    color: var(--color-primary-dark);
    text-decoration: none;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
    padding: 1rem 0 1.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.86rem;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
